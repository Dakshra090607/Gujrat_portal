{
  "name": "buildrule-gujarat",
  "private": true,
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev:client",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "start": "npm --prefix server start",
    "build": "npm --prefix client install && npm --prefix client run build",
    "test": "npm --prefix server test",
    "test:integration": "npm --prefix server run test:integration",
    "db:migrate": "npm --prefix server run db:migrate",
    "seed:source": "npm --prefix server run seed:source",
    "db:validate": "npm --prefix server run db:validate",
    "review:backfill": "npm --prefix server run review:backfill",
    "admin:create": "npm --prefix server run admin:create"
  },
  "dependencies": {
    "@neon/config": "^1.11.3",
    "@neon/env": "^1.6.15",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.1.12"
  }
}
