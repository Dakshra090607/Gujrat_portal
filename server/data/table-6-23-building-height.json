  "regulationVersion": "CGDCR 2017 (as identified in source context)",
  "scheduleTitle": "Building Height with respect to road width",
  "analysisRules": [
    {
      "id": "building-height-road-width",
      "text": "Regulation 6.6 says building height is regulated by the width of the road abutting the building unit; maximum permissible height follows Table 6.23, subject to its notes and other applicable provisions."
    }
  ],
  "generalProvisions": [
    {
      "title": "6.6 Building Height",
      "sourceText": [
        "The height of building shall be regulated according to the width of the road on which it abuts.",
        "The maximum permissible building height shall be regulated according to the width of the road on which it abuts as shown in Table 6.23.",
        "If two buildings next to each other have different heights, the required margin for the taller building shall apply. The source example states that where one building is 25 mts and the adjacent building is 45 mts, the minimum margin between them shall be 9.0 mts.",
        "Where the required margin is not provided, the length of common wall between any two semi-detached buildings shall not be less than 25% of the maximum width of the building parallel to the common wall joining them at every floor.",
        "Maximum permissible building height is subject to clearance from the Airport Authority."
      ]
    }
  ],
